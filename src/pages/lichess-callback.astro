<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Lichess — Peón Veloz</title>
  <meta name="description" content="Vinculación de cuenta de Lichess." />
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <p>Listo. Ya podés cerrar esta ventana.</p>
  <script>
    // El servidor ya escribió la cuenta en la base durante el callback: esta
    // página no transporta ni decide nada. Solo cierra el popup para que el
    // usuario vuelva a /verificar-lichess, que consulta el estado.
    const channel = new BroadcastChannel('lichess-auth');
    channel.postMessage({ done: true });
    channel.close();
    setTimeout(() => window.close(), 150);
  </script>
</body>
</html>
