---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Link expirado" description="El link ha caducado.">
  <div class="expired">
    <h1>El link ha caducado</h1>
    <ol id="pasos">
      <li>Abra el chat del evento en WhatsApp</li>
      <li>Envíe el nombre del evento</li>
      <li>El bot le responde con un link nuevo</li>
    </ol>
  </div>
</BaseLayout>

<script>
  // Las instrucciones no son las mismas para un jugador que para el organizador:
  // el jugador manda el nombre del evento, el organizador escribe `crear-evento`.
  //
  // Esto se resuelve acá y no en el frontmatter a propósito: el sitio se
  // prerenderiza, así que el HTML se genera una vez y `Astro.url` no ve el
  // query. Si algún día la página pasa a renderizarse por request, esto se puede
  // mover arriba.
  const esOrganizador = new URLSearchParams(location.search).get('caso') === 'organizador';

  if (esOrganizador) {
    const pasos = [
      'Abra el chat del bot en WhatsApp',
      'Escriba crear-evento',
      'El bot le responde con un link nuevo',
    ];

    document.querySelectorAll('#pasos li').forEach((li, i) => {
      li.textContent = pasos[i] ?? '';
    });
  }
</script>

<style is:global>
  .expired {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 2rem;
    color: var(--light);
  }

  .expired h1 {
    margin: 0 0 1.5rem;
    font-weight: bold;
  }

  .expired ol {
    color: var(--light);
    line-height: 2;
    padding-left: 1.25rem;
    margin: 0;
  }
</style>
