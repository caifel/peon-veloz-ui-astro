---
import BaseLayout from '../layouts/BaseLayout.astro';
import Loading from '../components/Loading.astro';
import PageShell from '../components/PageShell.astro';
---

<BaseLayout title="Registro" description="Formulario de registro">
  <PageShell title="Formulario de registro">
    <Loading />

    <form method="post" class="content" id="register-form">
      <input type="hidden" name="token" id="register-token" />

      <label>
        <span data-required>Nombres</span>
        <input type="text" name="firstName" autocomplete="given-name" required />
      </label>

      <label>
        <span data-required>Apellidos</span>
        <input type="text" name="lastName" autocomplete="family-name" required />
      </label>

      <label>
        <span data-required>Fecha de nacimiento</span>
        <input type="date" name="birthDate" id="birth-date" autocomplete="bday" required />
      </label>

      <label>
        <span data-required>Departamento</span>
        <select name="stateName" required>
          <option value="" disabled selected>Selecciona...</option>
          <option value="BN">Beni</option>
          <option value="CH">Chuquisaca</option>
          <option value="CB">Cochabamba</option>
          <option value="LP">La Paz</option>
          <option value="OR">Oruro</option>
          <option value="PD">Pando</option>
          <option value="PT">Potosí</option>
          <option value="SC">Santa Cruz</option>
          <option value="TR">Tarija</option>
        </select>
      </label>

      <!-- La cuenta de Lichess se vincula despues, en /verificar-lichess. -->
      <small id="error-box" class="error-box" hidden></small>

      <button type="submit" class="action" id="register-submit">Continuar</button>
    </form>
  </PageShell>
</BaseLayout>

<script>
  import { redirectIfExpired } from '../lib/token-expired';

  // Endpoints
  // PUBLIC_API_URL overrides both defaults (e.g. ngrok or a LAN IP such as
  // http://192.168.1.42:4000). Set it in ui-astro/.env for local overrides.
  //   - dev  (astro dev):   defaults to the Docker API on http://localhost:4000
  //   - prod (astro build): defaults to same-origin, because the API serves
  //     the built Astro files itself (single origin, no CORS involved)
  const API = import.meta.env.PUBLIC_API_URL ?? (import.meta.env.DEV ? 'http://localhost:4000' : '');
  const AUTH_REGISTER = `${API}/api/auth/register`;
  const REGISTER_TOKEN = `${API}/api/register`;

  // DOM
  const form = document.getElementById('register-form');
  const submitBtn = document.getElementById('register-submit');
  const errorBox = document.getElementById('error-box');
  const fields = form.querySelectorAll('input:not([type=hidden]), select');

  // Helpers
  function disable(state) {
    fields.forEach((f) => (f.disabled = state));
    submitBtn.disabled = state;
  }

  function sleep(ms) {
    return new Promise((r) => setTimeout(r, ms));
  }

  // Startup
  const loading = document.getElementById('loading');

  const token = document.getElementById('register-token');
  token.value = new URLSearchParams(location.search).get('t') ?? '';

  const today = new Date();
  today.setFullYear(today.getFullYear() - 5);
  document.getElementById('birth-date').max = today.toISOString().split('T')[0];

  (async () => {
    let status;
    const check = fetch(`${REGISTER_TOKEN}/${token.value}`)
      .then((r) => {
        status = r.status;
      })
      .catch(() => {});
    await Promise.all([check, sleep(2000)]);

    if (redirectIfExpired(status)) return;

    loading.style.opacity = '0';
    await sleep(300);
    loading.remove();
  })();

  // Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const body = new FormData(form);
    disable(true);

    try {
      const res = await fetch(AUTH_REGISTER, { method: 'POST', body });

      if (!res.ok) {
        if (redirectIfExpired(res.status)) return;
        throw new Error(await res.text());
      }

      const data = await res.json().catch(() => null);
      const lichessLink = data?.data?.lichessLink;

      // El destino de después del registro todavía no existe: la inscripción y el
      // mensaje de confirmación llegan con la inversión del flujo (el registro
      // pasa a ser posterior al pago). Por ahora, si el evento es online se
      // vincula la cuenta del jugador y si no, se vuelve al inicio.
      if (lichessLink) {
        window.location.href =
          `/verificar-lichess?t=${encodeURIComponent(lichessLink)}&next=${encodeURIComponent('/')}`;
        return;
      }

      window.location.href = '/';
    } catch (err) {
      errorBox.hidden = false;
      errorBox.innerHTML = err?.message || 'Error al enviar el registro. Intenta de nuevo.';
      disable(false);
    }
  });
</script>

<!-- Lo compartido (page, header, content, action, error-box, loading) vive en
     PageShell. Acá solo queda lo propio del formulario. -->
<style>
  .content label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-weight: 300;
    color: var(--light);
  }

  .content input,
  .content select {
    width: 100%;
  }
</style>
