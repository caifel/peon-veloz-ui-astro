---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
---

<BaseLayout
  title="Inscripción"
  description="Completá el pago para confirmar tu participación en el torneo."
>
  <PageShell title="Inscripción">
    <div class="content">
      <p class="tournament" id="tournament" hidden></p>
      <p class="hint" id="hint">Comprobando el link…</p>
      <p id="status" hidden></p>
    </div>

    <a id="verify-link" class="action" href="" hidden>Vincular mi cuenta</a>
  </PageShell>
</BaseLayout>

<script>
  import { goToExpired, redirectIfExpired } from '../lib/token-expired';

  const API = import.meta.env.PUBLIC_API_URL ?? (import.meta.env.DEV ? 'http://localhost:4000' : '');

  const token = new URLSearchParams(location.search).get('t') ?? '';

  const tournamentEl = document.getElementById('tournament');
  const hint = document.getElementById('hint');
  const statusBox = document.getElementById('status');
  const verifyLink = document.getElementById('verify-link');

  function fail(message) {
    hint.hidden = true;
    statusBox.className = 'error-box';
    statusBox.hidden = false;
    statusBox.textContent = message;
  }

  (async () => {
    if (!token) return goToExpired();

    let data;
    try {
      const res = await fetch(`${API}/api/checkout/${encodeURIComponent(token)}`);
      if (redirectIfExpired(res.status)) return;
      if (!res.ok) return fail('No pudimos verificar el link de inscripción.');
      data = await res.json();
    } catch {
      return fail('No pudimos conectar con el servidor. Reintentá en un momento.');
    }

    const name = data.tournamentName || data.tournament;
    if (name) {
      tournamentEl.textContent = name;
      tournamentEl.hidden = false;
    }

    // Torneo online sin cuenta vinculada: el paso siguiente es verificarla, y
    // volvemos acá para terminar la inscripción.
    if (data.isOnline && !data.hasLichess) {
      if (!data.lichessLink) {
        return fail('No pudimos generar el link para vincular tu cuenta. Reintentá en un momento.');
      }

      verifyLink.href = `/verificar-lichess?t=${encodeURIComponent(
        data.lichessLink,
      )}&next=${encodeURIComponent(`/checkout?t=${token}`)}`;
      hint.textContent =
        'Este torneo se juega online. Antes de inscribirte hay que vincular tu cuenta de Lichess.';
      verifyLink.hidden = false;
      return;
    }

    hint.textContent = 'Completá el pago para confirmar tu participación.';

    if (data.isOnline && data.lichessUsername) {
      statusBox.className = 'ok-box';
      statusBox.hidden = false;
      statusBox.textContent = `Cuenta de Lichess vinculada: ${data.lichessUsername}`;
    }
  })();
</script>

<style>
  .tournament {
    margin: 0;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hint {
    margin: 0;
    color: var(--dim);
  }
</style>
