---
/**
 * Cascarón de las páginas del flujo (registro, vinculación de Lichess, checkout).
 *
 * Provee el header y la acción principal fija abajo. Los estilos salen tal cual
 * de la página de registro, que es el lenguaje visual de referencia: así las
 * tres no pueden volver a divergir.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="page">
  <div class="header">
    <h1>{title}</h1>
  </div>
  <slot />
</div>

<style is:global>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .header {
    background: var(--panel);
    height: var(--height-control);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Columna de contenido: mismo ancho, padding y separación en todas. */
  .content {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 500px;
    padding: 0 2rem;
  }

  /* Acción principal, fija al bottom. */
  .action {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100vw;
    height: var(--height-control);
    color: var(--dark);
    background: var(--white);
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-weight: bold;
    letter-spacing: 2px;
    z-index: 100;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* `hidden` no alcanza: `.action` fija display:flex y le gana. */
  .action[hidden] {
    display: none;
  }

  .action:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .error-box,
  .ok-box {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid transparent;
  }

  .error-box:not([hidden]) {
    display: block;
    border-color: lightcoral;
  }

  .ok-box:not([hidden]) {
    display: block;
    border-color: lightgreen;
  }

  .loading {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--dark);
    color: var(--light);
    transition: opacity 0.3s;
  }

  /* Mismo motivo que .action[hidden]: .loading fija display:flex. */
  .loading[hidden] {
    display: none;
  }
</style>
