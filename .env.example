# Public API base URL used by browser scripts in src/pages/*.astro.
#
# Leave this unset for the normal Docker workflow:
#   dev  -> http://localhost:4000  (the API published by ops/docker-compose.yml)
#   prod -> same origin            (the API serves the built Astro files)
#
# Set it only when the browser must reach the API somewhere else, for example
# a LAN IP or an ngrok tunnel:
# PUBLIC_API_URL=http://192.168.1.42:4000
